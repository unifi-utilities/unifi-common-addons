# Safe side-by-side canary defaults. Loopback avoids exposing the unauthenticated
# setup and player APIs. Before a canary that will later become LAN-accessible,
# set both service URLs to that final trusted LAN address while leaving
# BIND_ADDR on loopback; AfterTouch persists those URLs on first start.
BIND_ADDR=127.0.0.1
PORT=18000
HTTPS_PORT=18443
SERVER_URL=http://127.0.0.1:18000
HTTPS_SERVER_URL=https://127.0.0.1:18443
DEPLOYMENT_MODE=private-network
DATA_DIR=/data/aftertouch-service/data

# Persistent settings.json values take precedence after first start. Review the
# Settings page and data/settings.json when changing these values later.
REDACT_PROXY_LOGS=true
LOG_PROXY_BODY=false
RECORD_INTERACTIONS=false
DISCOVERY_ENABLED=false
DISCOVERY_INTERVAL=5m
UPDATE_CHECK_ENABLED=false
UPDATE_CHECK_INTERVAL=24h

# Port 53 is already owned by UniFi services. This addon deliberately rejects
# DNS discovery even if these values are changed.
ENABLE_DNS_DISCOVERY=false
DNS_UPSTREAM=
DNS_BIND_ADDR=127.0.0.1:53

# Replace the password before activation. The setup and player APIs still use
# the LAN trust boundary; management authentication does not protect all routes.
MGMT_USERNAME=admin
MGMT_PASSWORD=change_me!

# Optional provider configuration. Secrets remain in this root-owned file or in
# DATA_DIR; never commit a populated config.env.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REDIRECT_URI=

TUNEIN_OPML_URL=
TUNEIN_API_URL=
TTS_PROVIDER=
TTS_GOOGLE_API_KEY=
TTS_GOOGLE_ENDPOINT=
TTS_LANGUAGE=
TTS_VOICE=
TTS_APP_KEY=
TTS_VOLUME=0
INTERNAL_PATHS=
TLS_EXTRA_HOST=

# Stockholm is not distributed by this addon. An operator-supplied tree is
# accepted only below /data/aftertouch-service/stockholm.
STOCKHOLM_DIR=
STOCKHOLM_BASE_PATH=/stockholm

# Optional comma-separated Bose device IDs required in the healthcheck result.
EXPECTED_DEVICE_IDS=
AFTERTOUCH_HEALTH_TIMEOUT=60
