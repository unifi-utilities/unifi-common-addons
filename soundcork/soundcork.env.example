# Copy to /data/soundcork/soundcork.env on the UniFi controller.
# Keep this file free of SoundCork account data or speaker tokens.

# Controller DNS name or LAN IP reachable by SoundTouch speakers.
# UniFi-managed LANs commonly resolve "unifi" to the controller/gateway.
SOUNDCORK_HOST=unifi

# Speaker-facing HTTP port. 8001 avoids UniFi services that may occupy
# localhost:8000 on some gateways.
SOUNDCORK_PORT=8001

# Runtime self-healing settings used by 05-soundcork-runtime.sh. The Docker
# daemon config is restored from /data so it survives UniFi firmware updates.
SOUNDCORK_STATE_DIR=/data/soundcork
DOCKER_DAEMON_SOURCE=/data/soundcork/docker-daemon.json
DOCKER_DAEMON_TARGET=/etc/docker/daemon.json
SOUNDCORK_RUNTIME_PREFER=docker
SOUNDCORK_RUNTIME_AUTO_INSTALL=0
SOUNDCORK_RUNTIME_APT_PACKAGE=docker.io

# Keep boot-time apt-get update disabled by default. Enable only if package
# metadata may be missing and a slower network-dependent boot hook is OK.
# SOUNDCORK_RUNTIME_APT_UPDATE=0

# Speaker-facing SoundCork base URL. Leave unset to derive it from
# SOUNDCORK_HOST and SOUNDCORK_PORT.
# BASE_URL=http://${SOUNDCORK_HOST}:${SOUNDCORK_PORT}

# Gunicorn listen address inside the host-networked container.
GUNICORN_BIND=0.0.0.0:${SOUNDCORK_PORT}

# HTTP readiness settings used after the container is started.
SOUNDCORK_READY_TIMEOUT=90
SOUNDCORK_READY_INTERVAL=2
SOUNDCORK_READY_LOG_LINES=80
# SOUNDCORK_READY_URL=http://127.0.0.1:${SOUNDCORK_PORT}/bmx/registry/v1/services

# Healthcheck settings. "auto" checks Spotify accounts when Spotify support is
# configured; use 1 to force the check or 0 to disable it.
SOUNDCORK_HEALTHCHECK_TIMEOUT=5
SOUNDCORK_HEALTHCHECK_SPOTIFY=auto
# SOUNDCORK_HEALTHCHECK_SPOTIFY_ACCOUNT=

# Persistent controller-host paths.
DATA_DIR=/data/soundcork/data
LOG_DIR=/data/soundcork/logs

# Log retention. Docker installs use the per-container defaults below; the
# Docker daemon example has matching host-wide limits. The direct nspawn
# launcher uses SOUNDCORK_LOG_MAX_BYTES and SOUNDCORK_LOG_ROTATIONS for its
# file logger.
SOUNDCORK_CONTAINER_LOG_DRIVER=local
SOUNDCORK_CONTAINER_LOG_MAX_SIZE=10m
SOUNDCORK_CONTAINER_LOG_MAX_FILE=3
SOUNDCORK_LOG_MAX_BYTES=10485760
SOUNDCORK_LOG_ROTATIONS=3

# Direct nspawn settings. Use these with the rootfs provisioner and direct
# nspawn launcher.
# SOUNDCORK_ROOTFS=/data/soundcork/nspawn-rootfs
# SOUNDCORK_NSPAWN=/usr/bin/systemd-nspawn
# SOUNDCORK_APP_DIR=/opt/soundcork/soundcork
# SOUNDCORK_PYTHONPATH=/opt/soundcork
# SOUNDCORK_VENV=/opt/soundcork-venv
# SOUNDCORK_GUNICORN=/opt/soundcork-venv/bin/gunicorn

# Rootfs provisioning settings. The provisioner is intended for manual use, not
# as an on-boot hook. Keep host package installation disabled unless you are
# intentionally allowing the script to install debootstrap on the host.
# SOUNDCORK_ROOTFS_SUITE=trixie
# SOUNDCORK_ROOTFS_MIRROR=http://deb.debian.org/debian
# SOUNDCORK_ROOTFS_INCLUDE=ca-certificates,curl,git,python3,python3-pip,python3-venv
# SOUNDCORK_ROOTFS_INSTALL_HOST_TOOLS=0
# SOUNDCORK_ROOTFS_APT_UPDATE=0
# SOUNDCORK_ROOTFS_MIN_PYTHON=3.12
# SOUNDCORK_ROOTFS_PYTHON=/usr/bin/python3
# SOUNDCORK_REPO_URL=https://github.com/deborahgu/soundcork.git
# SOUNDCORK_REPO_REF=main

# Optional Spotify support. Required for cold-start Spotify presets and
# SoundTouch-managed Spotify playback; Spotify Connect can work without it.
# Create a Spotify Developer app with Web API and Web Playback SDK enabled,
# and with this redirect URI:
# http://127.0.0.1:18001/callback
#
# Uncomment these lines and fill in the app credentials on the controller.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:18001/callback

# Container settings.
IMAGE=ghcr.io/deborahgu/soundcork:main
CONTAINER_NAME=soundcork
SOUNDCORK_WORKERS=2

# Fixed-image example after building or selecting a SoundCork image with the
# features you need. Pin by digest in production when possible.
# IMAGE=ghcr.io/<owner>/soundcork:<tag-or-digest>
# SPOTIFY_ZEROCONF_PRIMER_ENABLED=true
# SPOTIFY_ZEROCONF_PRIME_DEVICES=<soundtouch-device-id-or-ip>
# SOUNDCORK_WORKERS=1
