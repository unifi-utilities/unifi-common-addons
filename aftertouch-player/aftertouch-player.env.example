# The player API has no authentication. Use one trusted LAN IPv4 address.
BIND_ADDR=192.0.2.1
PORT=18080

# Conservative default: list speaker IPv4 addresses explicitly and disable
# network discovery. Separate multiple values with commas.
SOUNDTOUCH_DEVICES=192.0.2.10
UPNP_ENABLED=false
MDNS_ENABLED=false
DISCOVERY_INTERFACE=

# Optional comma-separated Bose device IDs required in the healthcheck result.
EXPECTED_DEVICE_IDS=

# The standalone player must not be pointed at SoundCork. Leave both empty.
SERVICE_URL=
SERVICE_CA=

# Healthcheck timeout in seconds.
AFTERTOUCH_HEALTH_TIMEOUT=30
